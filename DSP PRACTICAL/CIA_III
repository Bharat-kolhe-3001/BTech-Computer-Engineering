#include <iostream>
#include <iomanip>
#include <string>
using namespace std;

class Book {
    string title;
    string author;
    int stock;

public:
    void addBook() {
        cout << "Enter book title: ";
        cin >> ws;
        getline(cin, title);
        cout << "Enter author name: ";
        getline(cin, author);
        cout << "Enter stock quantity: ";
        cin >> stock;
    }

    void display() const {
        cout << "| " << setw(20) << left << title
             << "| " << setw(20) << left << author
             << "| " << setw(10) << left << stock << " |\n";
    }

    void updateStock(int newStock) {
        stock = newStock;
        cout << "Stock updated successfully.\n";
    }

    void clear() {
        title = "";
        author = "";
        stock = 0;
        cout << "Book removed successfully.\n";
    }

    string getTitle() const {
        return title;
    }

    int getStock() const {
        return stock;
    }
};

void teacherMenu(Book books[], int &count);
void studentMenu(Book books[], int count);

int main() {
    Book books[50];
    int count = 0, choice;

    do {
        cout << "\nLibrary Management System\n1. Teacher\n2. Student\n9. Exit\nEnter your choice: ";
        cin >> choice;

        switch (choice) {
            case 1: {
                string username, password;
                cout << "Teacher Login\nUsername: ";
                cin >> username;
                cout << "Password: ";
                cin >> password;

           
                if (username == "Teacher" && password == "teacher123") {
                    cout << "Teacher Login Successful\n";
                    teacherMenu(books, count);
                } else {
                    cout << "Invalid login credentials.\n";
                }
                break;
            }
            case 2: {
                string username, password;
                cout << "Student Login\nUsername: ";
                cin >> username;
                cout << "Password: ";
                cin >> password;

                if (username == "Student" && password == "student123") {
                    studentMenu(books, count);
                } else {
                    cout << "Invalid login credentials.\n";
                }
                break;
            }
            case 9:
                cout << "Exiting... Thank you!\n";
                break;
            default:
                cout << "Invalid choice. Try again.\n";
        }
    } while (choice != 9);

    return 0;
}


void teacherMenu(Book books[], int &count) {
    int choice;
    do {
        cout << "\n1. Add Book\n2. Update Stock\n3. Remove Book\n4. Show All Books\n9. Back to Main Menu\nEnter choice: ";
        cin >> choice;

        switch (choice) {
            case 1: {
                int numBooks;
                cout << "How many books do you want to add? ";
                cin >> numBooks;

                for (int i = 0; i < numBooks; i++) {
                    if (count < 50) {
                        cout << "\nAdding book " << i + 1 << ":\n";
                        books[count].addBook();
                        count++;
                    } else {
                        cout << "Inventory is full, cannot add more books.\n";
                        break;
                    }
                }
                break;
            }
            case 2: {
                string title;
                cout << "Enter book title to update stock: ";
                cin >> ws;
                getline(cin, title);

                for (int i = 0; i < count; i++) {
                    if (books[i].getTitle() == title) {
                        int newStock;
                        cout << "Enter new stock quantity: ";
                        cin >> newStock;
                        books[i].updateStock(newStock);
                        break;
                    }
                }
                break;
            }
            case 3: {
                string title;
                cout << "Enter book title to remove: ";
                cin >> ws;
                getline(cin, title);

                int i;
                for (i = 0; i < count; i++) {
                    if (books[i].getTitle() == title) {
                       
                        for (int j = i; j < count - 1; j++) {
                            books[j] = books[j + 1];
                        }
                        count--
                        cout << "Book removed successfully.\n";
                        break;
                    }
                }
                if (i == count) { 
                    cout << "Book not found in the inventory.\n";
                }
                break;
            }
            case 4:
                cout << "\n+----------------------+----------------------+----------+\n";
                cout << "| " << setw(20) << left << "Title"
                     << "| " << setw(20) << left << "Author"
                     << "| " << setw(10) << left << "Stock" << " |\n";
                cout << "+----------------------+----------------------+----------+\n";
                for (int i = 0; i < count; i++) {
                    books[i].display();
                }
                cout << "+----------------------+----------------------+----------+\n";
                break;
            case 9:
                cout << "Returning to main menu...\n";
                break;
            default:
                cout << "Invalid choice. Try again.\n";
        }
    } while (choice != 9);
}


void studentMenu(Book books[], int count) {
    int choice;
    do {
        cout << "\n1. Borrow Book\n2. Return Book\n3. Show All Books\n9. Back to Main Menu\nEnter choice: ";
        cin >> choice;

        switch (choice) {
            case 1: {
                string title;
                cout << "Enter title of book to borrow: ";
                cin >> ws;
                getline(cin, title);

                bool bookFound = false; 
                for (int i = 0; i < count; i++) {
                    if (books[i].getTitle() == title) {
                        if (books[i].getStock() > 0) {
                            books[i].updateStock(books[i].getStock() - 1);
                            cout << "Book borrowed successfully.\n";
                        } else {
                            cout << "Book out of stock.\n";
                        }
                        bookFound = true;
                        break;
                    }
                }

                if (!bookFound) {
                    cout << "Book not found in the inventory.\n";
                }
                break;
            }

            case 2: {
                string title;
                cout << "Enter title of book to return: ";
                cin >> ws;
                getline(cin, title);

                int i;
                for (i = 0; i < count; i++) {
                    if (books[i].getTitle() == title) {
                        books[i].updateStock(books[i].getStock() + 1);
                        cout << "Book returned successfully.\n";
                        break;
                    }
                }

                if (i == count) {  
                    cout << "Book not found in the inventory.\n";
                }
                break;
            }

            case 3:
                cout << "\n+----------------------+----------------------+----------+\n";
                cout << "| " << setw(20) << left << "Title"
                     << "| " << setw(20) << left << "Author"
                     << "| " << setw(10) << left << "Stock" << " |\n";
                cout << "+----------------------+----------------------+----------+\n";
                for (int i = 0; i < count; i++) {
                    books[i].display();
                }
                cout << "+----------------------+----------------------+----------+\n";
                break;

            case 9:
                cout << "Returning to main menu...\n";
                break;

            default:
                cout << "Invalid choice. Try again.\n";
        }
    } while (choice != 9);
}